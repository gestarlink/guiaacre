# Cloudflare D1 database (configured in wrangler.jsonc)
# No env vars needed - binding is automatic via wrangler config

# JWT secret for auth tokens (required)
JWT_SECRET="sua-chave-secreta-aqui-mude-em-producao"

# Google Maps API key (required) - Places API
GOOGLE_MAPS_API_KEY="sua-chave-aqui"

# Site URL (for development)
SITE_URL="http://localhost:8080"
